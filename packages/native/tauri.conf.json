{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jiti",
  "version": "0.1.0",
  "identifier": "com.jiti.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Jiti",
        "url": "index.html",
        "width": 640,
        "height": 440,
        "minWidth": 360,
        "minHeight": 220,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": true,
        "skipTaskbar": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}